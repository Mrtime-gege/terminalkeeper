{
  "name": "terminalkeeper",
  "version": "0.1.1",
  "description": "持久化 tmux 终端面板（DSH Web）：多会话管理、复用同一 shell、锁与归属、提示信息与审计复盘。",
  "author": "Mrtime-gege <327958341+Mrtime-gege@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrtime-gege/terminalkeeper.git"
  },
  "homepage": "https://github.com/Mrtime-gege/terminalkeeper#readme",
  "bugs": {
    "url": "https://github.com/Mrtime-gege/terminalkeeper/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/terminalkeeper.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "install-deps.sh",
    "lib/args.js",
    "lib/audit-checkpoints.mjs",
    "lib/audit.js",
    "lib/audit-verdict.mjs",
    "lib/backup.mjs",
    "lib/channel.js",
    "lib/client.js",
    "lib/config-local.mjs",
    "lib/consent.js",
    "lib/disposition.mjs",
    "lib/env.mjs",
    "lib/index.js",
    "lib/obfuscate.mjs",
    "lib/param-spec.mjs",
    "lib/pure.mjs",
    "lib/retention.mjs",
    "lib/settings-registry.mjs",
    "lib/statehead.mjs",
    "lib/supervisor/client.mjs",
    "lib/supervisor/daemon.mjs",
    "lib/supervisor/protocol.mjs",
    "lib/supervisor/tmux-adapter.mjs",
    "lib/tmux.js",
    "lib/tool-docs.js",
    "lib/vault-io.mjs",
    "lib/vault.mjs",
    "lib/vault-policy.mjs",
    "lib/watchdog.mjs",
    "LICENSE",
    "package.json",
    "purge-all.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "agent",
    "ai-agent",
    "terminal",
    "tmux",
    "shell",
    "persistent-shell",
    "interactive-terminal",
    "pty",
    "web-ui"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "bin": {
    "terminalkeeper": "bin/terminalkeeper.mjs"
  },
  "meta": {
    "title": "Agent Shell",
    "description": "在 DSH Web 界面里提供持久化 tmux 终端面板：多会话管理、复用同一 shell、锁与归属、提示与审计复盘。"
  },
  "icon": "./icon.svg"
}
